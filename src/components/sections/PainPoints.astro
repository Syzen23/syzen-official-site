---
const painPoints = [
  {
    id: "01",
    text: "Bisnis terasa jalan di tempat karena operasional masih manual dan belum punya sistem yang siap melayani pelanggan 24 jam penuh?",
    rotation: "-rotate-1",
    pinColor: "from-blue-400 to-blue-600",
  },
  {
    id: "02",
    text: "Kualitas layanan Anda luar biasa, tapi sayangnya tidak tercermin dari tampilan website yang terkesan kaku dan kurang profesional?",
    rotation: "rotate-1",
    pinColor: "from-sky-400 to-sky-600",
  },
  {
    id: "03",
    text: "Sering kalah saing karena identitas digital Anda terlihat 'kembar' dengan kompetitor akibat memakai template yang terlalu pasaran?",
    rotation: "-rotate-[1.5deg]",
    pinColor: "from-emerald-400 to-emerald-600",
  },
  {
    id: "04",
    text: "Kapok pakai jasa web murah yang menjanjikan bulan bintang, namun hasilnya penuh error dan ditinggal kabur tanpa support teknis?",
    rotation: "rotate-[1.5deg]",
    pinColor: "from-indigo-400 to-indigo-600",
  },
  {
    id: "05",
    text: "Sedang bersiap untuk pitching dan butuh company profile digital kelas premium yang bonafide untuk meyakinkan klien besar?",
    rotation: "-rotate-1",
    pinColor: "from-blue-400 to-indigo-600",
  },
  {
    id: "06",
    text: "Traffic iklan sudah kencang, tapi konversi bocor karena website super lambat dan layout-nya berantakan saat dibuka di HP?",
    rotation: "rotate-1",
    pinColor: "from-sky-400 to-blue-600",
  },
];
---

<section class="section scroll-mt-24 md:scroll-mt-28 bg-[#0a1628]" id="pain-points">
  <div class="container">
    <div class="space-y-12">
      <div class="max-w-[760px] mx-auto text-center reveal-on-scroll">
        <p class="section-kicker">Problem & Kendala</p>
        <h2 class="section-heading-h2 mb-4">
          Sering Mengalami Hal Ini di Bisnis Kamu?
        </h2>
        <p class="text-slate-300 text-[15px] sm:text-base font-inter max-w-[600px] mx-auto">
          Jika salah satu dari masalah di bawah ini sering membuat kamu pusing, saatnya beralih ke solusi website profesional yang benar-benar bekerja untukmu.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {
          painPoints.map((point, index) => (
            <div
              class={`reveal-on-scroll h-full ${point.rotation} transition-transform duration-500 hover:rotate-0 hover:z-10`}
              style={`transition-delay: ${index * 80}ms;`}
            >
              <div class="relative h-full flex flex-col p-6 sm:p-7 rounded-lg bg-brand-card/90 backdrop-blur-sm border border-white/10 shadow-[0_12px_30px_rgba(0,0,0,0.3)] transition-all duration-300 hover:-translate-y-2 hover:border-brand-accent/30 hover:shadow-[0_20px_45px_rgba(59,130,246,0.1)] group mt-3">
                
                {/* Pushpin (Jarum Pentul) */}
                <div class="absolute -top-3 left-1/2 -translate-x-1/2 flex items-center justify-center z-20 transition-transform duration-300 group-hover:-translate-y-1">
                  <div class={`w-4.5 h-4.5 rounded-full bg-gradient-to-br ${point.pinColor} shadow-[0_4px_6px_rgba(0,0,0,0.6),inset_0_-2px_4px_rgba(0,0,0,0.3)] relative border border-black/20`}>
                    {/* Pin Highlight for 3D effect */}
                    <div class="absolute top-[2px] left-[2px] w-1.5 h-1.5 rounded-full bg-white/70 blur-[0.5px]"></div>
                  </div>
                  {/* Pin shadow on the card */}
                  <div class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-3 h-1.5 bg-black/40 blur-[2px] rounded-full -z-10"></div>
                </div>

                {/* Header: Number */}
                <div class="flex justify-end items-start mb-4">
                  <div class="text-slate-500/70 font-inter font-bold text-[11px] tracking-widest uppercase">
                    {point.id} &mdash; 06
                  </div>
                </div>

                {/* Text */}
                <p class="text-slate-200 text-[14.5px] sm:text-[15px] leading-relaxed font-inter font-medium relative z-10 m-0 text-center sm:text-left">
                  {point.text}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- Wave: PainPoints #0a1628 → Services #050d1a -->
<div class="section-wave" style="background-color:#0a1628;" aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 80" preserveAspectRatio="none">
    <path d="M0,0 L0,45 C200,15 400,68 600,38 C800,10 1040,65 1200,40 C1320,22 1400,58 1440,42 L1440,80 L0,80 Z" fill="#050d1a"/>
  </svg>
</div>
