---
import { MessageSquareMore } from "lucide-react";
import { portfolioProjects, whatsappUrl } from "../../data/siteConfig";
---

<section class="section bg-[#050d1a]" id="portfolio">
  <div class="container">
    <div class="max-w-[760px] mb-7 reveal-on-scroll">
      <p class="section-kicker">Portfolio</p>
      <h2 class="section-heading-h2">
        Visual premium, sedikit tapi fokus untuk menunjukkan kualitas arah
        desain.
      </h2>
    </div>

    {/* TABS NAVIGATION */}
    <div class="flex justify-start mb-10 reveal-on-scroll">
      <div
        class="inline-flex bg-[#0a1628] border border-white/10 rounded-full p-1 relative overflow-hidden hide-scrollbar max-w-full overflow-x-auto whitespace-nowrap"
      >
        <button
          data-filter="all"
          class="portfolio-tab relative z-10 px-5 sm:px-6 py-2.5 rounded-full text-[13px] sm:text-sm font-medium transition-colors duration-300 text-white"
          >Semua</button
        >
        <button
          data-filter="landing"
          class="portfolio-tab relative z-10 px-5 sm:px-6 py-2.5 rounded-full text-[13px] sm:text-sm font-medium transition-colors duration-300 text-slate-400 hover:text-white"
          >Landing Page</button
        >
        <button
          data-filter="company"
          class="portfolio-tab relative z-10 px-5 sm:px-6 py-2.5 rounded-full text-[13px] sm:text-sm font-medium transition-colors duration-300 text-slate-400 hover:text-white"
          >Company Profile</button
        >
        <button
          data-filter="custom"
          class="portfolio-tab relative z-10 px-5 sm:px-6 py-2.5 rounded-full text-[13px] sm:text-sm font-medium transition-colors duration-300 text-slate-400 hover:text-white"
          >Sistem Kustom</button
        >

        {/* Active pill background */}
        <div
          class="portfolio-tab-indicator absolute top-1 bottom-1 bg-brand-accent rounded-full transition-all duration-300 ease-out z-0 pointer-events-none"
          style="width: 0; left: 4px;"
        >
        </div>
      </div>
    </div>

    <!-- Symmetrical Grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8"
      id="portfolio-grid"
    >
      {
        portfolioProjects.map((project, index) => (
          <div
            class="project-card-wrapper col-span-1 reveal-on-scroll h-full"
            style={`transition-delay: ${index * 80}ms;`}
            data-category={project.filterGroup}
          >
            <article
              class="overflow-hidden border border-white/6 rounded-2xl bg-brand-card shadow-[0_12px_36px_rgba(0,0,0,0.3)] transition-all duration-300 hover:-translate-y-1.5 hover:border-brand-accent/30 hover:shadow-[0_16px_40px_rgba(59,130,246,0.1)] group flex flex-col h-full"
              style={`--accent: ${project.accent};`}
            >
              <div class="relative bg-brand-bg overflow-hidden border-b border-white/6 flex flex-col shrink-0">
                {/* Browser Header Bar */}
                <div class="flex items-center justify-between h-[34px] px-3.5 bg-[rgba(26,17,54,0.9)] border-b border-white/5 select-none shrink-0">
                  {/* Traffic Lights */}
                  <div class="flex gap-1.5 items-center">
                    <span class="w-2 h-2 rounded-full bg-[#FF5F56] opacity-90 shadow-[0_0_8px_rgba(255,95,86,0.2)]" />
                    <span class="w-2 h-2 rounded-full bg-[#FFBD2E] opacity-90 shadow-[0_0_8px_rgba(255,189,46,0.2)]" />
                    <span class="w-2 h-2 rounded-full bg-[#27C93F] opacity-90 shadow-[0_0_8px_rgba(39,201,63,0.2)]" />
                  </div>
                  {/* URL Bar */}
                  <div class="w-[50%] h-[18px] rounded bg-white/5 border border-white/5 flex items-center justify-center text-[9px] text-slate-400 font-inter font-medium tracking-wide">
                    {project.url}
                  </div>
                  <div class="w-10" />
                </div>

                {/* Viewport with simple, elegant hover zoom image */}
                <div class="relative h-[200px] sm:h-[220px] overflow-hidden bg-[rgba(20,13,44,0.5)]">
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-104"
                    loading="lazy"
                    decoding="async"
                  />
                  {/* Soft shading overlays */}
                  <div class="absolute inset-x-0 top-0 h-3 bg-gradient-to-b from-brand-bg/40 to-transparent pointer-events-none" />
                  <div class="absolute inset-x-0 bottom-0 h-3 bg-gradient-to-t from-brand-bg/40 to-transparent pointer-events-none" />
                </div>
              </div>

              {/* Details Section */}
              <div class="p-5 flex flex-col justify-between flex-grow">
                <div>
                  <span class="block mb-2 text-brand-gold text-[11px] font-extrabold uppercase tracking-widest font-inter">
                    {project.category}
                  </span>
                  <h3 class="mb-2 text-white text-[16px] sm:text-[17px] font-bold leading-tight font-jakarta group-hover:text-brand-gold transition-colors duration-200">
                    {project.title}
                  </h3>
                  <p class="m-0 text-slate-300 text-[13.5px] sm:text-[14px] leading-relaxed font-inter">
                    {project.description}
                  </p>
                </div>

                <div class="border-t border-white/6 pt-4 mt-auto">
                  <a
                    class="w-full py-2.5 rounded-xl bg-brand-accent border border-brand-accent text-white hover:bg-white hover:text-brand-accent font-bold text-[13.5px] sm:text-[14px] flex items-center justify-center gap-2 transition-all duration-300 shadow-[0_4px_12px_rgba(59,130,246,0.15)] hover:shadow-[0_8px_20px_rgba(59,130,246,0.25)] font-jakarta tracking-wide"
                    href={whatsappUrl}
                    target="_blank"
                    rel="noreferrer"
                  >
                    <span>Diskusikan Style Ini</span>
                    <MessageSquareMore />
                  </a>
                </div>
              </div>
            </article>
          </div>
        ))
      }
    </div>

    <!-- Show More Button -->
    <div class="flex justify-center mt-10" id="show-more-container">
      <button
        id="btn-show-more"
        class="px-6 py-3 rounded-full border border-brand-accent/40 bg-brand-accent/6 text-white text-[14px] font-bold font-jakarta cursor-pointer shadow-lg hover:border-brand-accent hover:bg-brand-accent/15 hover:shadow-[0_8px_24px_rgba(59,130,246,0.2)] hover:-translate-y-0.5 transition-all duration-300"
      >
        <span id="btn-show-more-text">Lihat Semua Karya (+)</span>
      </button>
    </div>
  </div>
</section>

<!-- Wave: Portfolio #050d1a → Testimonials #0a1628 -->
<div class="section-wave" style="background-color:#050d1a;" aria-hidden="true">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1440 80"
    preserveAspectRatio="none"
  >
    <path
      d="M0,0 L0,35 C240,72 480,8 720,44 C960,78 1200,16 1440,50 L1440,80 L0,80 Z"
      fill="#0a1628"></path>
  </svg>
</div>

<script>
  function initPortfolio() {
    const grid = document.getElementById("portfolio-grid");
    if (!grid) return;

    const cards = Array.from(
      grid.querySelectorAll(".project-card-wrapper"),
    ) as HTMLElement[];
    const tabs = document.querySelectorAll(".portfolio-tab");
    const indicator = document.querySelector(
      ".portfolio-tab-indicator",
    ) as HTMLElement;
    const showMoreBtn = document.getElementById("btn-show-more");
    const showMoreBtnText = document.getElementById("btn-show-more-text");
    const showMoreContainer = document.getElementById("show-more-container");

    let showAll = false;
    let currentFilter = "all";
    let isAnimating = false;

    function setActiveTab(tab: HTMLElement) {
      tabs.forEach((t) => {
        t.classList.remove("text-white");
        t.classList.add("text-slate-400", "hover:text-white");
      });
      tab.classList.remove("text-slate-400", "hover:text-white");
      tab.classList.add("text-white");

      if (indicator) {
        indicator.style.width = `${tab.offsetWidth}px`;
        indicator.style.left = `${tab.offsetLeft}px`;
      }
    }

    function animateGrid(filterCardsFn: () => void) {
      if (isAnimating) return;
      isAnimating = true;

      // Fade out current visible cards
      const visibleCards = cards.filter((c) => c.style.display === "flex");
      visibleCards.forEach((c) => {
        c.style.transition = "opacity 200ms ease-out, transform 200ms ease-out";
        c.style.opacity = "0";
        c.style.transform = "translateY(10px) scale(0.98)";
      });

      setTimeout(() => {
        // Execute layout change
        filterCardsFn();

        // Fade in new visible cards
        const newVisibleCards = cards.filter((c) => c.style.display === "flex");
        newVisibleCards.forEach((c, i) => {
          c.style.transition = `opacity 400ms cubic-bezier(0.16, 1, 0.3, 1) ${i * 40}ms, transform 400ms cubic-bezier(0.16, 1, 0.3, 1) ${i * 40}ms`;
          // Force reflow
          void c.offsetWidth;
          c.style.opacity = "1";
          c.style.transform = "none";
        });

        setTimeout(
          () => {
            isAnimating = false;
          },
          400 + newVisibleCards.length * 40,
        );
      }, 200);
    }

    function applyFilterLayout() {
      if (currentFilter === "all") {
        if (showAll) {
          cards.forEach((card) => {
            card.style.display = "flex";
          });
          if (showMoreBtnText)
            showMoreBtnText.innerText = "Tampilkan Lebih Sedikit (-)";
        } else {
          cards.forEach((card, index) => {
            card.style.display = index < 3 ? "flex" : "none";
          });
          if (showMoreBtnText)
            showMoreBtnText.innerText = "Lihat Semua Karya (+)";
        }
        if (showMoreContainer) showMoreContainer.style.display = "flex";
      } else {
        if (showMoreContainer) showMoreContainer.style.display = "none";
        cards.forEach((card) => {
          const category = card.getAttribute("data-category");
          card.style.display = category === currentFilter ? "flex" : "none";
        });
      }
    }

    // Initial setup indicator
    setTimeout(() => {
      const activeTab = document.querySelector(
        ".portfolio-tab.text-white",
      ) as HTMLElement;
      if (activeTab) setActiveTab(activeTab);
    }, 100);

    window.addEventListener("resize", () => {
      const activeTab = document.querySelector(
        ".portfolio-tab.text-white",
      ) as HTMLElement;
      if (activeTab && indicator) {
        indicator.style.width = `${activeTab.offsetWidth}px`;
        indicator.style.left = `${activeTab.offsetLeft}px`;
      }
    });

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        if (isAnimating) return;
        const filter = tab.getAttribute("data-filter") || "all";
        if (filter === currentFilter) return;

        currentFilter = filter;
        setActiveTab(tab as HTMLElement);

        if (filter === "all") {
          showAll = false;
        }

        animateGrid(() => {
          applyFilterLayout();
        });
      });
    });

    if (showMoreBtn) {
      showMoreBtn.addEventListener("click", () => {
        if (isAnimating) return;
        showAll = !showAll;
        animateGrid(() => {
          applyFilterLayout();
        });
      });
    }

    // Initial layout
    applyFilterLayout();
  }

  document.addEventListener("DOMContentLoaded", initPortfolio);
  document.addEventListener("astro:page-load", initPortfolio);
</script>
