---
import { whatsappUrl } from "../../data/siteConfig";
import { CheckCircle, MessageSquare, ArrowRight } from "lucide-react";
---

<section
  class="section relative bg-transparent scroll-mt-24 md:scroll-mt-28 overflow-hidden py-24"
  id="contact"
>
  {/* Glowing Aesthetic Backdrops */}
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] sm:w-[500px] h-[350px] sm:h-[500px] bg-brand-coral/5 blur-[120px] rounded-full pointer-events-none -z-10"
  >
  </div>
  <div
    class="absolute bottom-4 right-10 w-72 h-72 bg-brand-gold/3 blur-[100px] rounded-full pointer-events-none -z-10"
  >
  </div>

  <div class="container">
    {/* Minimalist Brand-Colored CTA Box */}
    <div
      class="relative overflow-hidden rounded-3xl bg-brand-coral p-8 sm:p-10 lg:p-12 shadow-2xl reveal-on-scroll-scale"
    >
      <div
        class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-12 items-center relative z-10"
      >
        {/* Left Side: Minimal Typography */}
        <div class="text-center lg:text-left max-w-2xl w-full mx-auto lg:mx-0">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 border border-white/30 mb-5">
            <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
            <span class="text-white font-inter font-semibold text-[10.5px] tracking-widest uppercase">Konsultasi Gratis</span>
          </div>
          
          <h2
            class="text-[28px] sm:text-[34px] md:text-[40px] font-satoshi font-black text-white leading-[1.15] mb-5 tracking-tight"
          >
            Siap Melejitkan Penjualan<br class="hidden sm:block" />
            <span class="text-white/90 font-bold">dengan Website Premium?</span>
          </h2>
          
          <p
            class="text-white/90 text-[14px] sm:text-[15px] leading-relaxed font-inter lg:pr-10 m-0"
          >
            Jangan biarkan kompetitor merebut calon klien Anda. Diskusikan
            konsep website impian Anda bersama kami hari ini secara gratis,
            dan mulailah mendominasi pasar digital.
          </p>
        </div>

        {/* Right Side: Consultation Value Card & CTA Button */}
        <div class="flex flex-col w-full max-w-[420px] mx-auto lg:ml-auto">
          <div class="bg-white/10 border border-white/20 rounded-2xl p-6 sm:p-7 backdrop-blur-sm shadow-xl">
            <h3 class="text-white font-satoshi font-bold text-[15px] sm:text-[16px] mb-4 pb-3 border-b border-white/20">
              Value Konsultasi Gratis Kami:
            </h3>

            {/* Vertical Objection-Buster Benefit Checklist */}
            <div class="flex flex-col gap-3.5 mb-7 text-left">
              <div class="flex items-start gap-3">
                <div class="flex items-center justify-center w-4 h-4 rounded-full bg-white/20 shrink-0 mt-0.5">
                  <CheckCircle className="text-white w-2.5 h-2.5" strokeWidth={3} />
                </div>
                <span class="text-white text-[13.5px] sm:text-[14px] font-medium font-inter leading-relaxed">Gratis Sesi Tanya Jawab & Konsep</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="flex items-center justify-center w-4 h-4 rounded-full bg-white/20 shrink-0 mt-0.5">
                  <CheckCircle className="text-white w-2.5 h-2.5" strokeWidth={3} />
                </div>
                <span class="text-white text-[13.5px] sm:text-[14px] font-medium font-inter leading-relaxed">Saran Desain Custom & Premium</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="flex items-center justify-center w-4 h-4 rounded-full bg-white/20 shrink-0 mt-0.5">
                  <CheckCircle className="text-white w-2.5 h-2.5" strokeWidth={3} />
                </div>
                <span class="text-white text-[13.5px] sm:text-[14px] font-medium font-inter leading-relaxed">Audit Speed & SEO (Jika Punya Web Lama)</span>
              </div>
              <div class="flex items-start gap-3">
                <div class="flex items-center justify-center w-4 h-4 rounded-full bg-white/20 shrink-0 mt-0.5">
                  <CheckCircle className="text-white w-2.5 h-2.5" strokeWidth={3} />
                </div>
                <span class="text-white text-[13.5px] sm:text-[14px] font-medium font-inter leading-relaxed">Penjelasan Tanpa Bahasa Teknis yang Pusing</span>
              </div>
            </div>

            {/* Striking CTA Button */}
            <div class="relative group w-full">
              {/* High Contrast Button */}
              <a
                class="relative flex items-center justify-center gap-2.5 w-full px-5 py-3.5 bg-white text-brand-coral hover:bg-white/95 rounded-xl font-bold font-satoshi text-[14.5px] sm:text-[15px] transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5"
                href={whatsappUrl}
                target="_blank"
                rel="noreferrer"
              >
                {/* WhatsApp Native SVG Icon */}
                <svg 
                  xmlns="http://www.w3.org/2000/svg" 
                  viewBox="0 0 24 24" 
                  class="w-5 h-5 fill-brand-coral"
                >
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.662-2.06-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
                </svg>
                <span>Mulai Diskusi Sekarang</span>
              </a>
            </div>

            <p
              class="text-white/80 text-[11px] sm:text-[11.5px] font-medium font-inter mt-3.5 flex items-center justify-center gap-1.5"
            >
              <span class="relative flex h-1.5 w-1.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-white"></span>
              </span>
              <span>Aktif 24/7 • Estimasi Balas &lt; 10 Menit</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
</style>
