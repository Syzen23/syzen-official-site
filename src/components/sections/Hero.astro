---
import { whatsappUrl } from "../../data/siteConfig";
import { Sparkles, Code2, MonitorSmartphone, Rocket } from "lucide-react";
---

<section
  class="relative overflow-hidden bg-[#050d1a] pt-16 pb-12 lg:pt-32 lg:pb-16 flex items-center justify-center min-h-[50vh]"
  aria-label="Hero"
>
  {/* Centered Ambient Glow (Prevents clipping at edges) */}
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] max-w-[800px] h-[300px] bg-brand-accent/20 rounded-[100%] blur-[120px] pointer-events-none animate-pulse-slow"
    aria-hidden="true"
  >
  </div>

  {/* Subtle dot grid texture with faded edges */}
  <div
    class="absolute inset-0 pointer-events-none opacity-60"
    style="background-image: radial-gradient(circle, rgba(59,130,246,0.15) 1px, transparent 1px); background-size: 32px 32px; mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 20%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 20%, transparent 100%);"
    aria-hidden="true"
  >
  </div>

  {/* Content */}
  <div
    class="relative z-10 px-6 w-full max-w-[1000px] mx-auto text-center flex flex-col items-center"
  >
    <h1
      class="mt-0 mb-6 text-white text-4xl sm:text-5xl md:text-6xl lg:text-[4.5rem] xl:text-[5rem] font-jakarta font-extrabold leading-[1.05] tracking-tighter animate-title"
    >
      Jasa Pembuatan Website Modern untuk <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400 pb-2 inline-block -mb-2"
        >Bisnis Profesional</span
      >
    </h1>
    <p
      class="mt-0 mb-8 md:mb-10 text-slate-300 text-base md:text-[1.15rem] font-inter leading-relaxed animate-desc max-w-[650px]"
    >
      Syzen Web membantu UMKM, company profile, dan bisnis kreatif memiliki
      website yang modern, cepat, dan mudah dipercaya customer.
    </p>
    <div class="flex flex-wrap justify-center gap-4 animate-cta">
      <a
        class="button button-primary relative group overflow-hidden"
        href={whatsappUrl}
        target="_blank"
        rel="noreferrer"
      >
        <span class="relative z-10">Konsultasi Gratis</span>
        <div
          class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"
        >
        </div>
      </a>
      <a class="button button-secondary" href="#portfolio"> Lihat Portfolio </a>
    </div>
  </div>
</section>

<style>
  /* ── Entrance Animations ── */
  @keyframes heroFadeInUp {
    from {
      opacity: 0;
      transform: translateY(22px) scale(0.99);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-15px) rotate(4deg);
    }
  }

  @keyframes pulseSlow {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.05);
    }
  }

  .animate-float {
    animation: float 4.5s ease-in-out infinite;
  }

  .animate-pulse-slow {
    animation: pulseSlow 8s ease-in-out infinite;
  }

  .animate-kicker {
    opacity: 0;
    animation: heroFadeInUp 650ms cubic-bezier(0.16, 1, 0.3, 1) forwards 120ms;
  }
  .animate-title {
    opacity: 0;
    animation: heroFadeInUp 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards 220ms;
  }
  .animate-desc {
    opacity: 0;
    animation: heroFadeInUp 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards 360ms;
  }
  .animate-cta {
    opacity: 0;
    animation: heroFadeInUp 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards 500ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-kicker,
    .animate-title,
    .animate-desc,
    .animate-cta,
    .animate-float,
    .animate-pulse-slow {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
  }
</style>

<!-- Wave: Hero → ValueStrip+PainPoints #0a1628 -->
<div class="section-wave" style="background-color:#050d1a;" aria-hidden="true">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1440 100"
    preserveAspectRatio="none"
    style="height:100px;"
  >
    <path
      d="M0,0 L0,30 C160,90 320,5 480,55 C640,100 800,10 960,55 C1120,98 1300,20 1440,60 L1440,100 L0,100 Z"
      fill="#0a1628"></path>
  </svg>
</div>
